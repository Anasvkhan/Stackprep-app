PORT=5000
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/stackprep?retryWrites=true&w=majority
JWT_SECRET=replace-with-long-random-string
JWT_EXPIRES_IN=30d

# Forgot-password emails. Set EmailJS (sends from your Gmail) or Mailjet; EmailJS wins if both are set.
# Leave all empty in local dev: the code is printed to the console instead.
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=
MAILJET_API_KEY=
MAILJET_SECRET_KEY=
MAIL_FROM_EMAIL=you@example.com
MAIL_FROM_NAME=StackPrep
