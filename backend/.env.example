PORT=5000
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/stackprep?retryWrites=true&w=majority
JWT_SECRET=replace-with-long-random-string
JWT_EXPIRES_IN=30d

# Forgot-password emails (Mailjet). Leave empty in local dev: the code is printed to the console instead.
MAILJET_API_KEY=
MAILJET_SECRET_KEY=
MAIL_FROM_EMAIL=you@example.com
MAIL_FROM_NAME=StackPrep
